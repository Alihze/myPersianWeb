# ==============================================================================
# ۱. پیکربندی پایه و تنظیم صفحه خطای ۴۰۴
# ==============================================================================
DirectoryIndex index.html
Options -Indexes -MultiViews
ErrorDocument 404 /404.html

# ==============================================================================
# ۲. هدرهای امنیتی و سیگنال‌های مثبت سئو (Security Headers & Trust)
# ==============================================================================
<IfModule mod_headers.c>
  # جلوگیری از حملات Clickjacking و جعل فریم
  Header set X-Frame-Options "SAMEORIGIN"

  # مهار حدس زدن اشتباه نوع فایل‌ها (MIME sniffing)
  Header set X-Content-Type-Options "nosniff"

  # حفظ حریم خصوصی ارجاع‌دهنده‌ها برای حفظ اعتبار لینک‌ها
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # فعال‌سازی پروتکل سخت‌گیرانه امنیتی HTTPS (HSTS) به مدت یک سال
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ==============================================================================
# ۳. شناسایی صحیح پسوندها (به‌ویژه برای موتور جستجوی Pagefind و فونت‌ها)
# ==============================================================================
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/javascript .js
  AddType text/css .css
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/manifest+json .webmanifest
  AddType application/xml .xml
</IfModule>

# ==============================================================================
# ۴. فشرده‌سازی حداکثری (Gzip / Deflate) - تقویت شاخص Core Web Vitals
# ==============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/wasm
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE font/woff
</IfModule>

# فعال‌سازی پروتکل اتصالات مداوم جهت افزایش سرعت ارتباط با سرور
<IfModule mod_headers.c>
  Header set Connection keep-alive
</IfModule>

# فشرده‌سازی فوق‌پیشرفته Brotli (در صورت پشتیبانی هاست)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/wasm
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml font/woff2
</IfModule>

# ==============================================================================
# ۵. کش مرورگر (Browser Caching) - افزایش چشمگیر سرعت لود مجدد
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # کدهای HTML (کش کوتاه تا تغییرات جدید فوراً دیده شوند)
  ExpiresByType text/html "access plus 1 hour"

  # فایل‌های سیستمی و هش‌شده Astro و استایل‌ها (کش طولانی ۱ ساله)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"

  # تصاویر و فونت‌ها
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"

  # موتور جستجو و نقشه سایت
  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

# ==============================================================================
# ۶. موتور بازنویسی آدرس‌ها و قوانین سئو (URL Canonicalization & Redirects)
# ==============================================================================
RewriteEngine On
RewriteBase /

# الف) اجبار قطعی به HTTPS (جلوگیری از جریمه محتوای تکراری Duplicate Content)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ب) حذف www و یکپارچه‌سازی دامنه (Canonical Host: codeelite.ir)
RewriteCond %{HTTP_HOST} ^www\.codeelite\.ir$ [NC]
RewriteRule ^ https://codeelite.ir%{REQUEST_URI} [L,R=301]

# ==============================================================================
# ۷. ریدایرکت ۳۰۱ ردپاهای وردپرس قبلی به صفحه اصلی
# ==============================================================================
# ۱. پوشه‌ها و فایل‌های سیستمی وردپرس
RewriteRule ^(wp-admin|wp-content|wp-includes|wp-json|xmlrpc\.php|wp-login\.php).*$ / [R=301,L,NC]

# ۲. ساختارهای دسته‌بندی، برچسب، نویسنده و فیدهای قدیمی وردپرس
RewriteRule ^(category|tag|author|feed|comments|trackback)/.*$ / [R=301,L,NC]

# ۳. تمام فایل‌های پی‌اچ‌پی باقیمانده از سایت قبلی
RewriteRule ^.*\.php$ / [R=301,L,NC]

# ۴. ریدایرکت پارامترهای پیش‌فرض وردپرس (مانند ?p=123 یا ?cat=5)
RewriteCond %{QUERY_STRING} ^(p|page_id|m|cat|tag|author)= [NC]
RewriteRule ^$ /? [R=301,L]

# ==============================================================================
# ۸. مسیریابی هوشمند صفحات استاتیک Astro Starlight
# ==============================================================================
# ۱. اگر فایل یا پوشه حقیقی وجود دارد، بدون تغییر باز شود
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ۲. تطبیق خودکار آدرس دروس با فایل index.html درون پوشه‌ها
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*)/?$ /$1/index.html [L]

# ۳. ریدایرکت ۳۰۱ تمام پست‌ها و صفحات قدیمی و ناموجود وردپرس به صفحه اصلی
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ / [R=301,L]
