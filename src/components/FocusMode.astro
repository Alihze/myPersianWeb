---
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isLanding = pathname === '/' || pathname === '/about' || pathname === '';
const isSplash = Astro.props.entry?.data?.template === 'splash' || isLanding;
---

{!isSplash && (
  <div class="zen-floating-container">
    <button
      type="button"
      class="zen-btn"
      data-zen-toggle
      aria-label="حالت تمرکز برای مطالعه"
    >
      <!-- آیکون ورود به تمرکز -->
      <svg class="zen-icon zen-icon-enter" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
      </svg>
      <!-- آیکون خروج از تمرکز -->
      <svg class="zen-icon zen-icon-exit" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
      <span id="zen-btn-text">حالت تمرکز</span>
    </button>
  </div>

  <script is:inline>
    (function () {
      function setupZen() {
        if (window.__zenAttached) return;
        window.__zenAttached = true;

        document.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-zen-toggle]');
          if (!btn) return;

          var isZen = document.documentElement.classList.toggle('zen-mode');
          var textEl = document.getElementById('zen-btn-text');
          var enterIcon = document.querySelector('.zen-icon-enter');
          var exitIcon = document.querySelector('.zen-icon-exit');

          if (isZen) {
            if (textEl) textEl.textContent = 'خروج از تمرکز (Esc)';
            if (enterIcon) enterIcon.style.display = 'none';
            if (exitIcon) exitIcon.style.display = 'inline-block';
            btn.classList.add('active');
          } else {
            if (textEl) textEl.textContent = 'حالت تمرکز';
            if (enterIcon) enterIcon.style.display = 'inline-block';
            if (exitIcon) exitIcon.style.display = 'none';
            btn.classList.remove('active');
          }
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && document.documentElement.classList.contains('zen-mode')) {
            document.documentElement.classList.remove('zen-mode');
            var textEl = document.getElementById('zen-btn-text');
            var enterIcon = document.querySelector('.zen-icon-enter');
            var exitIcon = document.querySelector('.zen-icon-exit');
            var btn = document.querySelector('[data-zen-toggle]');
            if (textEl) textEl.textContent = 'حالت تمرکز';
            if (enterIcon) enterIcon.style.display = 'inline-block';
            if (exitIcon) exitIcon.style.display = 'none';
            if (btn) btn.classList.remove('active');
          }
        });
      }

      setupZen();
      document.addEventListener('astro:page-load', setupZen);
    })();
  </script>
)}

<style>
  /* قرارگیری در پایین و مرکز صفحه به دور از هر دو سایدبار */
  .zen-floating-container {
    position: fixed !important;
    bottom: 2rem !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    z-index: 99999 !important;
    pointer-events: auto !important;
    direction: rtl !important;
  }

  .zen-btn {
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.6rem !important;
    padding: 0.65rem 1.4rem !important;
    font-size: 0.875rem !important;
    font-family: inherit !important;
    font-weight: 700 !important;
    color: #e2e8f0 !important;
    background: rgba(15, 23, 42, 0.92) !important;
    border: 1px solid rgba(56, 189, 248, 0.45) !important;
    border-radius: 9999px !important;
    backdrop-filter: blur(16px) !important;
    -webkit-backdrop-filter: blur(16px) !important;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(56, 189, 248, 0.3) !important;
    cursor: pointer !important;
    user-select: none !important;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
  }

  .zen-btn:hover {
    color: #38bdf8 !important;
    background: rgba(15, 23, 42, 0.98) !important;
    border-color: #38bdf8 !important;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.7), 0 0 25px rgba(56, 189, 248, 0.5) !important;
    transform: translateY(-2px) !important;
  }

  .zen-btn.active {
    background: rgba(30, 41, 59, 0.98) !important;
    border-color: #38bdf8 !important;
    color: #38bdf8 !important;
    box-shadow: 0 0 30px rgba(56, 189, 248, 0.6) !important;
  }

  .zen-btn * {
    pointer-events: none !important;
  }
</style>
