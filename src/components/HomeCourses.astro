---
const courses = [
  {
    title: 'مدار منطقی',
    desc: 'الفبای سخت‌افزار؛ یاد می‌گیریم چطور صفر و یک‌ها منطق کامپیوتر را می‌سازند.',
    icon: 'fa-microchip',
    link: '/digital-logic/'
  },
  {
    title: 'ریاضیات پایه',
    desc: 'درک مفاهیم مشتق و گرادیان؛ پیش‌نیاز اصلی الگوریتم‌های بهینه‌سازی و یادگیری ماشین.',
    icon: 'fa-calculator',
    link: '/math-basic/'
  },
  {
    title: 'ریاضی ۱',
    desc: 'مفاهیم حد، مشتق، انتگرال و سری‌ها؛ سنگ‌بنای تحلیل ریاضی و علوم محاسباتی.',
    icon: 'fa-arrow-trend-up',
    link: '/math-1/'
  },
  {
    title: 'ریاضی ۲',
    desc: 'حساب دیفرانسیل و انتگرال چندمتغیره؛ درک هندسی فضاها، گرادیان و بهینه‌سازی چندبعدی.',
    icon: 'fa-layer-group',
    link: '/math-2/'
  },
  {
    title: 'نظریه مجموعه ها',
    desc: 'زبان پایه‌ای ریاضی؛ زیربنای ساختارهای داده و تئوری پایگاه‌های داده (دیتابیس).',
    icon: 'fa-circle-nodes',
    link: '/set-theory/'
  },
  {
    title: 'ساختمان داده',
    desc: 'روش‌های بهینه برای چیدمان و نگهداری اطلاعات در حافظه.',
    icon: 'fa-sitemap',
    link: '/data-structures/'
  },
  {
    title: 'طراحی الگوریتم',
    desc: 'پیدا کردن سریع‌ترین و هوشمندانه‌ترین مسیر برای حل مسائل.',
    icon: 'fa-diagram-project',
    link: '/algorithms/'
  },
  {
    title: 'آنالیز ریاضی',
    desc: 'اثبات دقیق قضایای پیوسته؛ مفید برای تحلیل عمیق تئوری‌های یادگیری و بهینه‌سازی.',
    icon: 'fa-infinity',
    link: '/math-analysis/'
  },
  {
    title: 'آمار و احتمال',
    desc: 'مدل‌سازی عدم قطعیت؛ زیربنای اصلی هوش مصنوعی، داده‌کاوی و الگوریتم‌های تصادفی.',
    icon: 'fa-chart-simple',
    link: '/probability/'
  },
  {
    title: 'ریاضی گسسته',
    desc: 'زیربنای منطقی و ساختاریافته علوم کامپیوتر.',
    icon: 'fa-network-wired',
    link: '/discrete-math/'
  },
  {
    title: 'جبر خطی',
    desc: 'زبان اصلی داده‌کاوی، گرافیک و هوش مصنوعی.',
    icon: 'fa-table-cells',
    link: '/linear-algebra/'
  },
  {
    title: 'آنالیز عددی',
    desc: 'طراحی الگوریتم‌ها برای حل کامپیوتری و تقریبی معادلات پیچیده‌ای که حل دقیق ندارند.',
    icon: 'fa-square-root-variable',
    link: '/numerical-analysis/'
  },
  {
    title: 'مبانی منطق',
    desc: 'الفبای استدلال؛ پایه طراحی مدارها، هوش مصنوعی نمادین و اثبات درستی نرم‌افزارها.',
    icon: 'fa-scale-balanced',
    link: '/math-logic/'
  },
  {
    title: 'نظریه محاسبات',
    desc: 'هسته تئوری کامپیوتر؛ تعیین اینکه چه مسائلی اساساً توسط الگوریتم‌ها قابل حل هستند.',
    icon: 'fa-gears',
    link: '/theory-of-computation/'
  },
  {
    title: 'ترکیبیات',
    desc: 'هنر شمارش و گراف‌ها؛ ابزاری حیاتی برای طراحی الگوریتم‌ها، رمزنگاری و محاسبه پیچیدگی زمانی.',
