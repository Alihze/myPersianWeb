---
import { Image } from 'astro:assets';
import authorImg from '../assets/author.webp';

// بررسی آدرس صفحه و قالب برای مخفی‌سازی در صفحات لندینگ
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isExcludedPage = pathname === '/' || pathname === '/about';
const isSplash = Astro.props.entry?.data?.template === 'splash';

const shouldShow = !isExcludedPage && !isSplash;
---

{shouldShow && (
  <aside class="author-box-card" aria-label="درباره مدرس">
    <div class="author-box-inner">
      <Image
        src={authorImg}
        alt="پرتره علی"
        class="author-avatar"
      />
      <div class="author-info">
        <div class="author-header">
          <h4 class="author-name">علی</h4>
          <span class="author-badge">جوینده دانش </span>
        </div>
        <p class="author-bio">
          علاقه‌مند به کاوش در زیبایی‌های دنیای ریاضیات و علوم کامپیوتر نظری. من در این پلتفرم تلاش می‌کنم مفاهیم بنیادین را به شکلی مفهومی، دقیق و کاربردی به اشتراک بگذارم.
        </p>
        <div class="author-links">
          <a href="/about/" class="author-link primary">
            داستان مسیر من
          </a>

          <!-- آیکون لینکدین -->
          <a
            href="https://www.linkedin.com/in/aliakbar-hasanzadeh-95484b412"
            target="_blank"
            rel="noopener noreferrer"
            class="author-link icon-link"
            title="لینکدین"
            aria-label="LinkedIn"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
            </svg>
          </a>

          <!-- آیکون اینستاگرام -->
          <a
            href="https://www.instagram.com/alihz_cs"
            target="_blank"
            rel="noopener noreferrer"
            class="author-link icon-link"
            title="اینستاگرام"
            aria-label="Instagram"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </aside>
)}

<style>
 <style>
  .author-box-card {
    margin: 3.5rem 0 2rem 0;
    padding: 1.5rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0%, rgba(56, 189, 248, 0.05) 100%);
    border: 1px solid rgba(56, 189, 248, 0.2);
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    direction: rtl;
    text-align: right;
  }

  .author-box-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .author-avatar {
    width: 5.5rem !important;
    height: 5.5rem !important;
    border-radius: 50% !important;
    object-fit: cover !important;
    flex-shrink: 0;
    border: 2px solid rgba(56, 189, 248, 0.5) !important;
    box-shadow: 0 0 15px rgba(56, 189, 248, 0.25) !important;
    margin: 0 !important;
  }

  .author-info {
    flex: 1;
  }

  .author-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }

  .author-name {
    margin: 0 !important;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--sl-color-white);
  }

  .author-badge {
    font-size: 0.725rem;
    padding: 0.15rem 0.6rem;
    border-radius: 9999px;
    background: rgba(56, 189, 248, 0.12);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .author-bio {
    margin: 0.35rem 0 0.85rem 0 !important;
    font-size: 0.875rem;
    line-height: 1.8;
    color: var(--sl-color-gray-2);
  }

  /* ردیف دکمه‌ها با تراز کاملاً یکسان */
  .author-links {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .author-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.25rem;
    padding: 0 0.85rem;
    box-sizing: border-box;
    font-size: 0.8rem;
    text-decoration: none;
    border-radius: 0.5rem;
    color: var(--sl-color-gray-2);
    border: 1px solid var(--sl-color-gray-5);
    background: rgba(255, 255, 255, 0.02);
    transition: all 0.2s ease;
    line-height: 1;
  }

  .author-link:hover {
    color: var(--sl-color-white);
    border-color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
  }

  .author-link.primary {
    color: #38bdf8;
    border-color: rgba(56, 189, 248, 0.4);
    background: rgba(56, 189, 248, 0.08);
  }

  /* تنظیم دقیق کادر مربعی و وسط‌چین کردن کامل آیکون‌ها */
  .author-link.icon-link {
    width: 2.25rem !important;
    height: 2.25rem !important;
    min-width: 2.25rem !important;
    min-height: 2.25rem !important;
    padding: 0 !important;
    line-height: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .author-link.icon-link svg {
    display: block !important;
    width: 1.15rem !important;
    height: 1.15rem !important;
    margin: 0 !important;
    flex-shrink: 0 !important;
    transition: transform 0.2s ease;
  }

  .author-link.icon-link:hover svg {
    transform: scale(1.15);
  }

  @media (max-width: 48rem) {
    .author-box-inner {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }

    .author-header {
      justify-content: center;
      margin-top: 0.5rem;
    }

    .author-links {
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .author-header {
      flex-direction: column;
      align-items: center;
      gap: 0.45rem;
    }

    .author-name {
      margin: 0;
    }
  }

